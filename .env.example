# Copy this file to .env and fill in real values. .env is git-ignored; this file is committed.

# Required: get a key at https://developer.translink.ca
TRANSLINK_API_KEY=

# Required: postgresql://USER:PASSWORD@localhost:5432/translink_data
DATABASE_URL=

# Optional: shown to TransLink in the User-Agent so they can contact you
CONTACT_EMAIL=

# Optional: defaults shown
FEED_URL=https://gtfsapi.translink.ca/v3/gtfsrealtime
HTTP_TIMEOUT_SECONDS=10

# Optional: collect only in this window (HH:MM, America/Vancouver time), and never
# make more than DAILY_REQUEST_CAP requests per day. TransLink's limit is 1,000/day.
COLLECT_START=15:30
COLLECT_END=19:25
DAILY_REQUEST_CAP=950
